{
  "source": {
    "include": ["src"],
    "includePattern": ".+\\.ts$",
    "excludePattern": "(^|\\/|\\\\)node_modules"
  },
  "plugins": ["node_modules/better-docs/typescript"],
  "opts": {
    "destination": "./docs",
    "recurse": true,
    "pedantic": true,
    "template": "node_modules/better-docs"
  },
  "templates": {
    "better-docs": {
      "name": "Infinite Scroll Demo Documentation"
    }
  }
}
